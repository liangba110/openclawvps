# 软件授权平台配置

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=software_auth

# JWT密钥（必须更换！生成命令: python3 -c "import secrets; print(secrets.token_hex(32))"）
JWT_SECRET=your_jwt_secret_here

# 支付回调签名密钥（必须更换！）
CALLBACK_SIGN_KEY=your_callback_sign_key_here

# 调试模式（生产环境设为false）
DEBUG=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
